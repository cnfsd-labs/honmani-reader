<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for downloading dictionaries and browsing book catalogues (OPDS). The reader WebView
         blocks network loads and is served entirely from the APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Which network the phone is on (no Wi-Fi names, no location): over plain http a login
         waits until the server asks for it, again on each new network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Dictionary imports run as a data-sync foreground service so they finish when the user
         leaves the app. Needs a foreground service declaration in the Play Console. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Progress of dictionary downloads and imports (asked for when one starts, Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Adding cards to AnkiDroid through its content provider; AnkiDroid asks the user. -->
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <queries>
        <!-- AnkiDroid, to add cards. -->
        <provider android:authorities="com.ichi2.anki.flashcards" />
        <!-- Text-to-speech engines, for card audio from the phone's voice. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".HonmaniApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Honmani">

        <!-- Handles rotation and similar changes itself so the reader WebView (and the open book)
             survives them; Compose re-lays out on its own. One task (singleTask): a book opened
             from another app goes to the running reader instead of a second one inside that app. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for books in file managers and a browser's downloads. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Share" of EPUB files (shared text goes to the lookup). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>

        <!-- Shares card audio with AnkiDroid, which copies it into its collection. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
