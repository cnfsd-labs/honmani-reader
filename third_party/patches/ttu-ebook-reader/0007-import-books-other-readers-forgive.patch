+/** The browser's own parser forgives what the CSS parser throws on (an extra bracket). */
+function parseStyleSheet(css: string) {
+  try {
+    return parseCss(css);
+  } catch (_) {
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(css);
+    return parseCss([...sheet.cssRules].map((rule) => rule.cssText).join('\n'));
+  }
+}
+
 function encapsulatedSelectors(selectors: string[], parentSelector: string) {
   return selectors.map((selector) => `${parentSelector} ${selector}`);
 }
