+
+/** The id of a manifest item and, in order, those it falls back to. */
+function withFallbacks(id: string, items: EpubManifestItem[]) {
+  const ids: string[] = [];
+  let next: string | undefined = id;
+
+  while (next && !ids.includes(next)) {
+    const current: string = next;
+    ids.push(current);
+    next = items.find((item) => item['@_id'] === current)?.['@_fallback'];
+  }
+  return ids;
+}
+
+async function readText(entry: Entry | undefined) {
+  if (!entry?.getData) {
+    throw new Error('required file not found');
+  }
+  const bytes = await entry.getData(new Uint8ArrayWriter());
+
+  try {
+    return new TextDecoder(encodingOf(bytes)).decode(bytes);
+  } catch (_) {
+    return new TextDecoder().decode(bytes);
+  }
+}
+
+/** UTF-8 unless a byte order mark, UTF-16's zero bytes or the XML declaration say otherwise. */
+function encodingOf(bytes: Uint8Array) {
+  const [a, b] = bytes;
+
+  if (a === 0xfe && b === 0xff) return 'utf-16be';
+  if (a === 0xff && b === 0xfe) return 'utf-16le';
+
+  if (bytes.length >= 8) {
+    const zeros = (start: number) => [0, 2, 4, 6].filter((i) => bytes[start + i] === 0).length;
+
+    if (zeros(0) === 4 && zeros(1) === 0) return 'utf-16be';
+    if (zeros(1) === 4 && zeros(0) === 0) return 'utf-16le';
+  }
+
+  const head = String.fromCharCode(...bytes.slice(0, 200));
+  const declared = /^<\?xml[^>]*encoding\s*=\s*["']([^"']+)["']/.exec(head)?.[1] || 'utf-8';
+
+  return /^utf-16/i.test(declared) ? 'utf-8' : declared;
+}
