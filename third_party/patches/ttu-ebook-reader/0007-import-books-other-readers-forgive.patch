+
+/** The declared media type, or the file extension's where that isn't one the reader knows. */
+function mediaTypeOf(declared: string, entry: Entry) {
+  if (declared === 'text/html' || declared === 'text/x-oeb1-document') return PAGE;
+  if ([PAGE, CSS, NCX].includes(declared) || declared.startsWith('image/')) return declared;
+
+  return typeByExtension[path.extname(entry.filename).toLowerCase()] || declared;
